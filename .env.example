# ============================================================================
# AUTONOMOUS AI NEWS BUSINESS - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this to .env and fill in your actual values

# AI MODELS
# GROQ (REQUIRED - FREE): Get from https://console.groq.com/keys
GROQ_API_KEY=gsk-your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant

# OPENAI (OPTIONAL - Paid, used as fallback)
# If not set, system will use free Groq instead
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# NEWS APIS & SOURCES
NEWSAPI_API_KEY=your-newsapi-key-here
NEWSAPI_BASE_URL=https://newsapi.org/v2
SERPAPI_API_KEY=your-serpapi-key-here
GDELT_PROJECT=gdelt
RSS_FEEDS=https://feeds.bbc.co.uk/news/rss.xml,https://feeds.reuters.com/reuters/businessNews

# DATABASE (SUPABASE)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-key
SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional: for scripts/supabase_management_setup.py (https://supabase.com/dashboard/account/tokens)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=awzukqmkmnucoxlkyeqs
DATABASE_URL=postgresql://postgres:password@your-project.supabase.co:5432/postgres

# DEPLOYMENT
VERCEL_TOKEN=your-vercel-token
GITHUB_TOKEN=your-github-token
CLOUDFLARE_API_TOKEN=your-cloudflare-token
DOMAIN_NAME=your-domain.com

# REDIS
REDIS_URL=redis://localhost:6379

# ALERTING
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id
EMAIL_ALERTS=admin@example.com

# SYSTEM
DAEMON_INTERVAL_MINUTES=10
LOG_LEVEL=INFO
DEBUG=false
DEDUP_THRESHOLD=0.85
CONFIDENCE_THRESHOLD_FILTER=0.7
CONFIDENCE_THRESHOLD_PUBLISH=0.8
LLM_TEMPERATURE_REWRITE=0.3
LLM_TEMPERATURE_FACT_CHECK=0.2
MAX_WORKERS=4
